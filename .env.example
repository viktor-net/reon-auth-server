# DEV-стенд аутентификации ИС РЕОН 2.0 — образец переменных окружения.
#
# Значения ниже — ТОЛЬКО ДЛЯ ЛОКАЛЬНОГО DEV-СТЕНДА. Реальных секретов здесь нет.
# Порядок использования:
#   cp .env.example .env
#   # при необходимости изменить значения в .env (файл .env не коммитится)
#   docker compose up -d
#
# Без файла .env стенд тоже поднимается: docker-compose.yml содержит те же
# DEV-значения как значения по умолчанию, чтобы smoke-скрипты работали сразу.

# --- Администратор Keycloak (master realm, bootstrap) ---
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=dev-admin-change-me

# --- База данных Keycloak (контейнер reon-auth-postgres) ---
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=dev-keycloak-db-change-me

# --- Секреты OIDC-клиентов (confidential clients) ---
# reon-service: межсервисные вызовы, client_credentials
REON_SERVICE_CLIENT_SECRET=dev-reon-service-secret-change-me
# reon-dev-smoke: DEV-клиент только для smoke-проверки (ROPC), в проде запрещён
REON_DEV_SMOKE_CLIENT_SECRET=dev-reon-dev-smoke-secret-change-me

# --- Параметры smoke-скриптов (scripts/smoke-auth.sh, scripts/smoke-auth.ps1) ---
# Точка входа — nginx. Менять только если порт 8090 занят.
REON_AUTH_BASE_URL=http://localhost:8090
REON_REALM=reon
