        "http://localhost:4200/*",
        "http://localhost:4300/*"
      ],
      "webOrigins": [
        "http://localhost:4200",
        "http://localhost:4300"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*"
      },
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "web-origins",
        "acr",
        "basic",
        "reon-claims",
        "reon-api-audience"
